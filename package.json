{
	"name": "seelite",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc --noEmit && vite build",
		"preview": "vite preview",
		"test": "bun test tests/",
		"format": "biome format --write src scripts tests index.html",
		"format:check": "biome format src scripts tests index.html",
		"check:wiring": "node scripts/check-launcher-wiring.mjs",
		"probe": "npm run check:wiring && node scripts/probe-all.mjs",
		"probe:one": "npm run check:wiring && node scripts/probe-all.mjs --only",
		"probe:select": "node scripts/select-probes.mjs",
		"probe:evaluate": "node scripts/evaluate-probe-selection.mjs",
		"probe:pr": "node scripts/select-probes.mjs --run",
		"views": "node scripts/capture-views.mjs",
		"views:diff": "node scripts/diff-view-set.mjs",
		"probe:browser": "playwright install chromium"
	},
	"dependencies": {
		"three": "^0.170.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.6",
		"@types/bun": "^1.3.14",
		"@types/three": "^0.170.0",
		"playwright": "^1.62.1",
		"pngjs": "^7.0.0",
		"typescript": "^5.6.0",
		"vite": "^6.0.0"
	},
	"engines": {
		"node": ">=20",
		"bun": ">=1.1"
	},
	"allowScripts": {
		"esbuild@0.25.12": true
	}
}
